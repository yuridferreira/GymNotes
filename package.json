{
  "name": "treinos",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down --volumes --remove-orphans",
    "infra:seed": "docker cp infra/seed_users.sql \"$(docker compose ps -q db)\":/tmp/seed_users.sql && docker compose exec -T db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -f /tmp/seed_users.sql'",
    "infra:bootstrap": "bash infra/bootstrap_db.sh",
    "infra:check": "bash infra/check_db.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.9",
    "@react-navigation/native": "^7.1.18",
    "expo": "~54.0.9",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-picker-select": "^9.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-web": "^0.21.0"
  },
  "private": true
}
